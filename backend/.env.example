# Database Configuration
DOCOPS_DATABASE_URL=postgresql+psycopg2://docops:docops@localhost:5432/documentops
DOCOPS_STORAGE_DIR=./storage

# Processing Thresholds
DOCOPS_AUTO_APPROVE_THRESHOLD=0.90
DOCOPS_REVIEW_THRESHOLD=0.70

# CORS Configuration
DOCOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IBM Watson Credentials (Optional - System will use fallback if not provided)
DOCOPS_WATSONX_API_KEY=your_watsonx_api_key_here
DOCOPS_WATSONX_PROJECT_ID=your_watsonx_project_id_here
DOCOPS_WATSONX_URL=https://us-south.ml.cloud.ibm.com
DOCOPS_WATSONX_MODEL_ID=ibm/granite-3-0-8b-instruct
DOCOPS_WATSONX_DEPLOYMENT_ID=