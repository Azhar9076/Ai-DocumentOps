# AI DocumentOps — Environment Configuration

# 1. IBM watsonx.ai & Granite 3.0 Credentials
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# 2. Database Connection (Postgres Local / Neon Serverless)
# Local Docker / Postgres:
DATABASE_URL=postgresql+psycopg2://docops:docops@localhost:5432/documentops
# Neon Serverless DB Example:
# DATABASE_URL=postgresql+psycopg2://user:password@ep-sample-12345.us-east-2.aws.neon.tech/documentops?sslmode=require

# 3. Application Thresholds & CORS
DOCOPS_AUTO_APPROVE_THRESHOLD=0.90
DOCOPS_REVIEW_THRESHOLD=0.70
DOCOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# 4. Frontend API Base
VITE_API_BASE=http://localhost:8000
